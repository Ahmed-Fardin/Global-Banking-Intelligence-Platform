.silder-block.downtime .card {
    background-color: #cdcdcd;
    border: 0px solid transparent;
}
.silder-block.downtime .card:hover {
    -webkit-transform: translateY(0px) !important;
    transform: translateY(0px) !important;
}
.silder-block.downtime .card .card-body {
    background-color: #cdcdcd;
    padding: 0px;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    min-height: auto !important;
    -webkit-box-pack: start;
    -ms-flex-pack: start;
    justify-content: flex-start;
}
.silder-block.downtime .card .card-body .btn {
    margin-bottom: 0px !important;
    background-color: #cdcdcd;
    border-color: #cdcdcd;
    color: #000000;
    margin-top: 0px;
    padding-top: 0px !important;
    padding-bottom: 0px;
    text-transform: capitalize !important;
    padding-right: 10px;
    margin-right: 10px;
    border-radius: 0px;
    height: -webkit-fit-content;
    height: -moz-fit-content;
    height: fit-content;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -ms-flex-direction: row;
    flex-direction: row;
    -webkit-box-pack: start;
    -ms-flex-pack: start;
    justify-content: flex-start;
    padding-left: 0px;
    font-size: 14px;
}
.silder-block.downtime .card .card-body .btn:before {
    content: url("/images/mcb/default-album/notice-icon.png");
    margin-right: 5px;
}
.silder-block.downtime .card .card-body .card-text {
    min-height: auto !important;
}
.silder-block.downtime .card .card-body h3,
.silder-block.downtime .card .card-body h4 {
    display: none;
}
@media only screen and (max-width: 768px) {
    .silder-block.downtime .card .card-body {
        -webkit-box-orient: vertical;
        -webkit-box-direction: normal;
        -ms-flex-direction: column;
        flex-direction: column;
    }
}
@media only screen and (min-width: 768px) {
    .silder-block.downtime .card .card-body {
        -webkit-box-orient: horizontal;
        -webkit-box-direction: normal;
        -ms-flex-direction: row;
        flex-direction: row;
    }
}
.silder-block.downtime h4 {
